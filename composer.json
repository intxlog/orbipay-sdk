    "homepage": "https://www.alacriti.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "Alacriti Inc.",
            "homepage": "https://www.alacriti.com"
        }
    ],
    "require": {
        "php": ">=5.6",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "phpseclib/phpseclib": "~3.0"
    },
    "autoload": {
        "psr-4": { "Com\\Alacriti\\Checkout\\Client\\" : "lib/" }
